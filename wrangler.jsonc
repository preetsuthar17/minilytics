{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preet-datafast",
  "account_id": "ef1087da0ee7eb63ff60e490b6f43650",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // Daily data-retention cleanup. Only deletes anything when the RETENTION_DAYS secret is set.
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; the dashboard and /js/script.js are served as free static files.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "preet-datafast",
      // Replace with the id printed by `npx wrangler d1 create minilytics`.
      "database_id": "59fec98d-4f7a-4361-86b6-23cae8b2270a",
      "migrations_dir": "migrations"
    }
  ]
}
